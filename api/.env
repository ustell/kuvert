# Environment variables declared in this file are automatically made available to Prisma.
# See the documentation for more detail: https://pris.ly/d/prisma-schema#accessing-environment-variables-from-the-schema

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

# The following `prisma+postgres` URL is similar to the URL produced by running a local Prisma Postgres 
# server with the `prisma dev` CLI command, when not choosing any non-default ports or settings. The API key, unlike the 
# one found in a remote Prisma Postgres URL, does not contain any sensitive information.

# Recommended for most uses
DATABASE_URL=postgresql://postgres:KTkz123_SQL!@postgres:5432/assembly_db?schema=public

# For uses requiring a connection without pgbouncer
DATABASE_URL_UNPOOLED=postgresql://postgres:KTkz123_SQL!@postgres:5432/assembly_db?schema=public

# Parameters for constructing your own connection string
PGHOST=postgres
PGHOST_UNPOOLED=postgres
PGUSER=postgres
PGDATABASE=assembly_db
PGPASSWORD=KTkz123_SQL!

# Parameters for Vercel Postgres Templates
POSTGRES_URL=postgresql://postgres:KTkz123_SQL!@postgres:5432/assembly_db?schema=public
POSTGRES_URL_NON_POOLING=postgresql://postgres:KTkz123_SQL!@postgres:5432/assembly_db?schema=public
POSTGRES_USER=postgres
POSTGRES_HOST=postgres
POSTGRES_PASSWORD=KTkz123_SQL!
POSTGRES_DATABASE=assembly_db
POSTGRES_URL_NO_SSL=postgresql://postgres:KTkz123_SQL!@postgres:5432/assembly_db?schema=public
POSTGRES_PRISMA_URL=postgresql://postgres:KTkz123_SQL!@postgres:5432/assembly_db?schema=public

